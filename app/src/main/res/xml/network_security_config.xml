<!--
  Release builds: HTTPS only with system trust anchors. Zero cleartext traffic permitted.
  Debug builds override this in src/debug/res/xml/network_security_config.xml to allow local development servers.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
